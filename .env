# Groq LLM API Key (Required for Phase 2 LangGraph)
# Get yours here: https://console.groq.com/keys
GROQ_API_KEY="gsk_..."

# Model Selection
# Defaulting to 70b versatile for deep reasoning; alternatively use llama-3.1-8b-instant
GROQ_MODEL="llama-3.3-70b-versatile"

# Mock Mode (Set to true to bypass Groq API completely for offline testing)
MOCK_LLM_MODE="false"

# Database Configuration
# Fallback to SQLite if empty, otherwise e.g. postgresql://user:pass@localhost:5432/nova
DATABASE_URL="sqlite:///./nova.db"

# Server Settings
PORT=8000
ENV="development"
CORS_ORIGINS="*"
